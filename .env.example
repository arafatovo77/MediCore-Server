# MediCore Server Edition - example environment file.
# Copy this file to ".env" and fill in real values for your server.
# Never commit a filled-in .env, and never reuse these secrets elsewhere.

# Port the API / web app listens on.
# (With Docker Compose, the app is published on this port too.)
PORT=3000

# PostgreSQL password for the database service.
# Docker Compose only: Compose reads .env, creates the database with
# this password and builds the app's DATABASE_URL from it, so the two
# can never disagree. On a bare install, use the same password inside
# DATABASE_URL below.
POSTGRES_PASSWORD=

# PostgreSQL connection string (bare install; with Docker Compose the
# app receives its connection string from docker-compose.yml instead).
# Form: postgres://user:password@host:5432/medicore
DATABASE_URL=postgres://medicore:your-db-password@localhost:5432/medicore

# Secret used to sign login tokens. REQUIRED - the server refuses to
# start without a strong one. Use a long random string (32 characters
# or more) and keep it private: anyone who knows it can forge login
# tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=

# How long a login token stays valid.
JWT_EXPIRES_IN=8h
